APP_ENV=local
ALLOW_REAL_MODEL_CALLS=false
DEMO_LOGIN_ENABLED=false
WAREHOUSE_SIMULATION_ENABLED=false
WAREHOUSE_DELIVERY_ENABLED=false
WAREHOUSE_BASE_URL=http://127.0.0.1:8140
WAREHOUSE_TOKEN=
# Independent warehouse process uses its own token setting; use the same random local token.
MOCK_WAREHOUSE_TOKEN=
WAREHOUSE_TIMEOUT_SECONDS=2
OUTBOX_LEASE_SECONDS=15
OUTBOX_MAX_ATTEMPTS=3
WAREHOUSE_CALLBACKS_ENABLED=false
WAREHOUSE_CALLBACK_SECRET=
MOCK_WAREHOUSE_CALLBACK_BASE_URL=
MOCK_WAREHOUSE_CALLBACK_SECRET=
RECONCILIATION_MAX_ATTEMPTS=3
RECONCILIATION_DEADLINE_SECONDS=60
RECONCILIATION_MAX_CYCLES=3
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
# Local demo credentials only. Never reuse a real database or merchant account.
DATABASE_URL=postgresql+psycopg://aftercare:aftercare_local_only@127.0.0.1:55435/aftercare_demo
